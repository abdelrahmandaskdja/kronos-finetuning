{
  "symbol": "BTCFDUSD",
  "api": {
    "key_env": "BINANCE_1H_API_KEY",
    "secret_env": "BINANCE_1H_API_SECRET"
  },
  "strategy": {
    "mode": "single_interval",
    "single_interval": "1h",
    "primary_interval": "1h"
  },
  "models": {
    "1h": {
      "metric_name": "pred_close_vs_prev_pred_close"
    }
  },
  "execution": {
    "maker_client_order_prefix": "k1hfdd",
    "allow_same_bar_order_maintenance": true,
    "same_bar_maintenance_requires_existing_order": true,
    "primary_close_buffer_ms": 10000,
    "use_primary_peg_limit_maker": true
  },
  "risk": {
    "min_rebalance_notional_usdt": 5.0
  },
  "paths": {
    "runtime_root": "./trading/runtime/strategy_1h_only_btcfdusd",
    "state_path": "./trading/runtime/strategy_1h_only_btcfdusd/state.json",
    "signal_log_path": "./trading/runtime/strategy_1h_only_btcfdusd/signal_log.jsonl",
    "order_log_path": "./trading/runtime/strategy_1h_only_btcfdusd/order_log.jsonl",
    "status_log_path": "./trading/runtime/strategy_1h_only_btcfdusd/status_log.jsonl",
    "market_cache_dir": "./trading/runtime/strategy_1h_only_btcfdusd/market_cache"
  }
}
