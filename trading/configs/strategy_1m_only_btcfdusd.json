{
  "symbol": "BTCFDUSD",
  "api": {
    "key_env": "BINANCE_1M_API_KEY",
    "secret_env": "BINANCE_1M_API_SECRET"
  },
  "strategy": {
    "mode": "single_interval",
    "single_interval": "1m",
    "primary_interval": "1m"
  },
  "models": {
    "1m": {
      "metric_name": "pred_close_vs_prev_pred_close"
    }
  },
  "execution": {
    "maker_client_order_prefix": "k1fdd",
    "allow_same_bar_order_maintenance": true,
    "maker_buy_balance_buffer_pct": 0.0,
    "use_primary_peg_limit_maker": true,
    "fast_1m_enabled": true,
    "fast_1m_close_buffer_ms": 75,
    "fast_1m_same_bar_maintenance_interval_ms": 100,
    "fast_1m_ws_orders": true,
    "fast_1m_inference_device": "auto",
    "fast_1m_prewarm": true,
    "fast_1m_use_full_forecast_cycle": true
  },
  "risk": {
    "min_rebalance_notional_usdt": 5.0
  },
  "paths": {
    "runtime_root": "./trading/runtime/strategy_1m_only_btcfdusd",
    "state_path": "./trading/runtime/strategy_1m_only_btcfdusd/state.json",
    "signal_log_path": "./trading/runtime/strategy_1m_only_btcfdusd/signal_log.jsonl",
    "order_log_path": "./trading/runtime/strategy_1m_only_btcfdusd/order_log.jsonl",
    "status_log_path": "./trading/runtime/strategy_1m_only_btcfdusd/status_log.jsonl",
    "market_cache_dir": "./trading/runtime/strategy_1m_only_btcfdusd/market_cache"
  }
}
