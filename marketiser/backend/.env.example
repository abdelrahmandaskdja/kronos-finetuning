MARKETISER_APP_NAME=Marketiser API
MARKETISER_HOST=0.0.0.0
MARKETISER_PORT=8000
MARKETISER_API_PREFIX=/api
MARKETISER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKETISER_ENABLE_BINANCE_REST=true
MARKETISER_USE_MOCK_PREDICTIONS=true
MARKETISER_SYMBOLS=BTCUSDT
MARKETISER_CHART_INTERVALS=1m,5m,15m,1h,4h,1d
MARKETISER_FORECAST_HORIZONS=5m,1h,1d
MARKETISER_BOOTSTRAP_CANDLE_LIMIT=180
MARKETISER_MAX_CANDLE_LIMIT=240
MARKETISER_BINANCE_SNAPSHOT_POLL_SECONDS=5
MARKETISER_BINANCE_CANDLE_POLL_SECONDS=20
MARKETISER_STREAM_STATUS_TTL=20
MARKETISER_DATABASE_PATH=storage/marketiser.db
MARKETISER_BINANCE_REST_URL=https://api.binance.com
